; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; TODO: Decide on the user-facing name: "GAMS/TIMES/Veda" or "VedaPy"
#define MyAppName="GAMS/TIMES/Veda"
; Used for the AppId, Start menu group and file names, where "/" is not allowed.
; Never change it after the first release, or upgrades will install side by side.
#define MyAppId="VedaPy"
; TODO: Define the VedaPy version scheme. These are still the old GAMS release numbers.
#define MyAppVersion="21.9.1";
#define MyDirVersion="22.0";
#define UnInstInfo="{app}\.uninstinfo.ini"

[Setup]
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
AppName={#MyAppName}
; TODO: List the bundled component versions (GAMSPy, TIMES, Veda) or drop them
AppVerName={#MyAppName} {#MyAppVersion}
; TODO: Add AppPublisher, AppPublisherURL, AppSupportURL and AppUpdatesURL
ChangesEnvironment=yes
DefaultDirName={code:GetDefaultDir}
DefaultGroupName={#MyAppId}
PrivilegesRequired=admin
OutputBaseFilename={#MyAppId}-setup

UsePreviousLanguage=no
DirExistsWarning=no

SolidCompression=true
Compression=lzma/ultra
;Compression=none
ShowLanguageDialog=auto
AppId={#MyAppId}
ShowTasksTreeLines=true
AppVersion={#MyAppVersion}
AllowRootDirectory=true
UsePreviousAppDir=false
InternalCompressLevel=ultra
; TODO: Add VersionInfoCompany
VersionInfoTextVersion={#MyAppVersion}
VersionInfoVersion={#MyAppVersion}
VersionInfoDescription={#MyAppName} installer
AlwaysUsePersonalGroup=no
DiskSpanning=false
OutputDir=.
SetupIconFile=assets\vedapy.ico

WizardImageFile = assets\vedapy_left.bmp
WizardSmallImageFile = assets\vedapy_small.bmp
WizardSizePercent = 130

DisableWelcomePage=no
DisableDirPage=no
DisableProgramGroupPage=yes

[Files]
Source: innofiles\*.*; DestDir: {app}; Flags: ignoreversion recursesubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

; NOTE: [Files] does not create empty directories. Without these, PostgreSQL fails
; to start and Veda cannot connect to it.
[Dirs]
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_commit_ts"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_dynshmem"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_logical\mappings"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_logical\snapshots"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_notify"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_replslot"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_serial"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_snapshots"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_stat_tmp"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_tblspc"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_twophase"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\data\pg_wal\archive_status"
Name: "{app}\Veda\Veda2.0_localhost_4.4.0.0\pgsql\lib\pkgconfig"
Name: "{app}\Veda\GAMS_WrkTIMES"

[Icons]
; NOTE: The following entry contains an English phrase ("Uninstall"). You are free to translate it into another language if required.
Name: {group}\Uninstall {#MyAppId}; Filename: {uninstallexe}

[Run]
; NOTE: The following entry contains an English phrase ("Launch"). You are free to translate it into another language if required.
Filename: {app}\Veda\Veda2.0_localhost_4.4.0.0\Veda2.0.exe; Description: Launch Veda2.0; Flags: nowait postinstall skipifsilent

[Code]

{global variables}
var
   CertificateFile: String;
   LicenseStr, LicenseStrALP: AnsiString;
   LicenseTargetFile: String;
   L_LicenseSource: TLabel;
   L_Intro: TNewStaticText;
   wpGamsLicense: Integer;
   ST_License: TNewStaticText;
   TE_AccessCode: TEdit;
   TE_Server: TEdit;
   TE_Certificate: TEdit;
   TB_GetLicense: TButton;
   TB_Certificate: TButton;
   ST_AccessCode: TNewStaticText;
   ST_Server: TNewStaticText;
   ST_Certificate: TNewStaticText;
   ALPSuccess, IsOnPrem: Boolean;

function GetGamsDirVersion(Path: String): String;
var
  lines: AnsiString;
begin
  Result := '';
  if FileExists(Path + '\gamsstmp.txt') and FileExists(Path + '\optgams.def') then
  begin
    LoadStringFromFile(Path + '\gamsstmp.txt', lines);
    Result := Copy(lines, 5, 6);
  end;
end;


procedure BrowseCertificateFile(Sender: TObject);
var
  Success: Boolean;
begin
  Success := GetSaveFileName('Choose certificate file', CertificateFile, ExpandConstant('{userdesktop}'),
                            'certificate |*.crt', '*.crt');
  if Success then TE_Certificate.Text := CertificateFile;
end;

{Write license file from string}
function WriteLicenseFile(): Boolean;
begin
  Result := SaveStringToFile(LicenseTargetFile, LicenseStr, False)
  if not WizardSilent and not Result then MsgBox('Could not write license to file', mbInformation, MB_OK);
end;

{Get a default directory for installation}
function GetDefaultDir(Param: String): String;
begin
  Result := ExpandConstant('C:\GAMS_TIMES_Veda\{#MyDirVersion}');
end;

procedure CheckOnPremServer();
var
  URL: String;
begin
  URL := LowerCase(Trim(TE_Server.Text));
  TB_GetLicense.Enabled := ((Pos('http://', URL) = 1) or (Pos('https://', URL) = 1));
end;

procedure OnTEServerChange(Sender: TObject);
begin
  CheckOnPremServer();
end;

procedure CheckOnPrem(Sender: TObject);
var
  Prefix: String;
begin
  Prefix := 'abcdef12-';
  IsOnPrem := Copy(TEdit(Sender).Text, 1, Length(Prefix)) = Prefix;
  if (IsOnPrem) then
  begin
    ST_Server.Show();
    ST_Certificate.Show();
    TE_Server.Show();
    TE_Certificate.Show();
    TB_Certificate.Show();
    CheckOnPremServer();
    ST_License.Top := ST_Certificate.Top + ST_Certificate.Height + ScaleX(6);
  end
  else
  begin
    ST_Server.Hide();
    ST_Certificate.Hide();
    TE_Server.Hide();
    TE_Certificate.Hide();
    TB_Certificate.Hide();
    TB_GetLicense.Enabled := True;
    ST_License.Top := L_LicenseSource.Top + L_LicenseSource.Height + ScaleX(10);
  end;
end;

procedure UpdateLicenseSelection();
begin
  WizardForm.NextButton.Enabled := True;
  ST_License.Top := L_LicenseSource.Top + L_LicenseSource.Height + ScaleX(10);
  LicenseStr  := LicenseStrALP;
  L_LicenseSource.Caption := '';
  TE_AccessCode.Show();
  TB_GetLicense.Show();
  TB_Certificate.Show();
  ST_AccessCode.Show();
  CheckOnPrem(TE_AccessCode);

  ST_License.Caption := LicenseStr;
  ST_License.Font.Height := ScaleY(13);
end;

{Creates a shortcut for Veda and write this to .uninstinfo.ini}
procedure CreateShortcutVeda;
var
   Link: string;
begin
Link := ExpandConstant('{userdesktop}\Veda2.0.lnk')
CreateShellLink(Link, '',
                ExpandConstant('{app}\Veda\Veda2.0_localhost_4.4.0.0\Veda2.0.exe'), '', '', ExpandConstant('{app}\Veda\Veda2.0_localhost_4.4.0.0\Veda2.0.exe'), 0, SW_SHOWNORMAL);
SetIniString('file', 'shortcut_veda', Link, ExpandConstant('{#UnInstInfo}'));
end;

{Update the system PATH variable and a system GAMSDIR variable.}
procedure UpdatePath();
var
    Hive: Integer;
    SubKey, PathStr: String;
begin
   Hive := HKLM
   SubKey := 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment'
   RegWriteStringValue(Hive, SubKey, 'GAMSDIR', ExpandConstant('{app}'));
   if not RegQueryStringValue(Hive, SubKey, 'Path', PathStr) then    RegWriteExpandStringValue(Hive, SubKey, 'Path', '%GAMSDIR%;')
   else if Pos('%GAMSDIR%', PathStr) = 0 then RegWriteStringValue(Hive, SubKey, 'Path', '%GAMSDIR%;' + PathStr);

   // show a warning, that the System GAMSDIR will have a higher precedence
   if RegValueExists(HKCU, 'Environment', 'GAMSDIR')
   then MsgBox('A GAMSDIR user environment variable is present from a previous installation. When using the PATH variable, user GAMSDIR will take precedence over system GAMSDIR.', mbInformation, MB_OK)
end;

{Undo UpdatePath, but only if GAMSDIR still points to this installation.}
procedure RemovePath();
var
    Hive: Integer;
    SubKey, GamsDir, PathStr: String;
begin
   Hive := HKLM
   SubKey := 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment'
   if RegQueryStringValue(Hive, SubKey, 'GAMSDIR', GamsDir) and (GamsDir = ExpandConstant('{app}')) then
   begin
      RegDeleteValue(Hive, SubKey, 'GAMSDIR');
      if RegQueryStringValue(Hive, SubKey, 'Path', PathStr) and (StringChangeEx(PathStr, '%GAMSDIR%;', '', True) > 0) then
         RegWriteStringValue(Hive, SubKey, 'Path', PathStr);
   end;
end;

procedure GetALPLicense(Sender: TObject);
var
  ErrorLevel: Integer;
  ALPLogFile: String;
  ALPLogString: AnsiString;
  ALPLicenseFile: String;
  ArgString: String;
begin
  WizardForm.NextButton.Enabled := False;
  LicenseStrALP := '';
  ALPSuccess := False;
  ALPLicenseFile := ExpandConstant('{app}\_alp_license_tmp.txt');
  ALPLogFile := ExpandConstant('{app}\_gams_get_key_log.txt');
  ArgString := ExpandConstant('/C ""{app}\gamsgetkey.exe" ') + TE_AccessCode.Text + ' -o ' + ALPLicenseFile;
  if (IsOnPrem) then
  begin
    ArgString := ArgString + ' -s ' + Trim(TE_Server.Text);
    if Trim(TE_Certificate.Text) <> '' then ArgString := ArgString + ' -g ' + Trim(TE_Certificate.Text);
  end;
  ArgString := ArgString + ' > "' + ALPLogFile + '" 2>&1"';
  if Exec(ExpandConstant('{cmd}'), ArgString, ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, ErrorLevel) then
  begin
    if ErrorLevel = 0 then
    begin
      if LoadStringFromFile(ALPLicenseFile, LicenseStrALP) then
      begin
        ST_License.Caption := LicenseStrALP;
        LicenseStr := LicenseStrALP;
        DeleteFile(ALPLicenseFile);
        ALPSuccess := True;
      end;
    end
    else
    begin
      LoadStringFromFile(ALPLogFile, ALPLogString);
      ST_License.Caption := ALPLogString;
    end;
  end
  else
  begin
    ST_License.Caption := 'Error(' + IntToStr(ErrorLevel) + ')';
  end;
  DeleteFile(ALPLogFile);
  WizardForm.NextButton.Enabled := True;
end;

function HandleLicenseOptions(): Boolean;
begin
  Result := WriteLicenseFile;
end;

{Create License Page}
function CreateLicensePage(): Integer;
var
  Page: TWizardPage;
begin
  Page := CreateCustomPage(wpInstalling, 'GAMS License', 'Retrieve a license using your Access Code');

  L_Intro := TNewStaticText.Create(Page);
  L_Intro.Caption := 'Please enter your Access Code to retrieve a GAMS license.';
  L_Intro.AutoSize := True;
  L_Intro.Top := ScaleY(0);
  L_Intro.Parent := Page.Surface;

  L_LicenseSource := TLabel.Create(Page);
  L_LicenseSource.Caption := '';
  L_LicenseSource.Width := Page.SurfaceWidth;
  L_LicenseSource.Height := ScaleY(20);
  L_LicenseSource.Top := L_Intro.Top + L_Intro.Height + ScaleY(15);
  L_LicenseSource.Parent := Page.Surface;

  ST_AccessCode := TNewStaticText.Create(Page);
  ST_AccessCode.Caption := 'Access Code:';
  ST_AccessCode.Top := L_LicenseSource.Top + ScaleY(3);
  ST_AccessCode.Parent := Page.Surface;
  ST_AccessCode.Hide();

  TE_AccessCode := TEdit.Create(Page);
  TE_AccessCode.Font.Name := 'Courier New';
  TE_AccessCode.Width := ScaleX(300);
  TE_AccessCode.Top := L_LicenseSource.Top;
  TE_AccessCode.Left := ST_AccessCode.Left + ST_AccessCode.Width + ScaleX(5);
  TE_AccessCode.Parent := Page.Surface;
  TE_AccessCode.OnChange := @CheckOnPrem;
  TE_AccessCode.Hide();

  TE_Server := TEdit.Create(Page);
  TE_Server.Font.Name := 'Courier New';
  TE_Server.Width := ScaleX(300);
  TE_Server.Top := TE_AccessCode.Top + TE_AccessCode.Height;
  TE_Server.Left := TE_AccessCode.Left
  TE_Server.Parent := Page.Surface;
  TE_Server.OnChange := @OnTEServerChange;
  TE_Server.Hide();

  ST_Server := TNewStaticText.Create(Page);
  ST_Server.Caption := 'Server URL:';
  ST_Server.Top := TE_Server.Top + ScaleY(3);
  ST_Server.Parent := Page.Surface;
  ST_Server.Hide();

  TB_GetLicense := TButton.Create(Page);
  TB_GetLicense.Caption := 'Get License';
  TB_GetLicense.Width := ScaleX(100);
  TB_GetLicense.Height := TE_AccessCode.Height + ScaleY(2);
  TB_GetLicense.Top := L_LicenseSource.Top - ScaleY(1);
  TB_GetLicense.Left := TE_AccessCode.Left + TE_AccessCode.Width + ScaleX(5);
  TB_GetLicense.Parent := Page.Surface;
  TB_GetLicense.Hide();
  TB_GetLicense.OnClick := @GetALPLicense;

  TE_Certificate := TEdit.Create(Page);
  TE_Certificate.Font.Name := 'Courier New';
  TE_Certificate.Width := ScaleX(300);
  TE_Certificate.Top := TE_Server.Top + TE_Server.Height;;
  TE_Certificate.Left := TE_Server.Left;
  TE_Certificate.Parent := Page.Surface;
  TE_Certificate.Hide();

  TB_Certificate := TButton.Create(Page);
  TB_Certificate.Caption := 'Browse...';
  TB_Certificate.Width := ScaleX(100);
  TB_Certificate.Height := TE_Certificate.Height + ScaleY(2);
  TB_Certificate.Top := TE_Certificate.Top - ScaleY(1);
  TB_Certificate.Left := TB_GetLicense.Left;
  TB_Certificate.Parent := Page.Surface;
  TB_Certificate.Hide();
  TB_Certificate.OnClick := @BrowseCertificateFile;

  ST_Certificate := TNewStaticText.Create(Page);
  ST_Certificate.Caption := 'Certificate:';
  ST_Certificate.Top := TE_Certificate.Top + ScaleY(3);
  ST_Certificate.Parent := Page.Surface;
  ST_Certificate.Hide();

  ST_License := TNewStaticText.Create(Page);
  ST_License.Font.Name := 'Courier New';
  ST_License.Font.Height := ScaleY(13);
  ST_License.Top := L_LicenseSource.Top + L_LicenseSource.Height + ScaleX(10);
  ST_License.Height := ScaleY(78);
  ST_License.Parent := Page.Surface;

  Result := Page.ID;
end;

{called when a wizard page changes}
procedure CurPageChanged(CurPage: Integer);
begin
  if wpReady = CurPage then
  begin
    Wizardform.ReadyMemo.Lines.Add(#13#10 + 'Additional Tasks:');
    Wizardform.ReadyMemo.Lines.Add('    Install for all users');
    Wizardform.ReadyMemo.Lines.Add('    Add GAMS directory to PATH environment variable');
    Wizardform.ReadyMemo.Lines.Add('    Create a desktop icon for Veda2.0');
  end;
  
  if wpGamsLicense = CurPage then
  begin
    TE_Certificate.Text := ExpandConstant('{app}\gamslice.crt');
    UpdateLicenseSelection();
  end;

  if wpFinished = CurPage then
  begin
    LicenseTargetFile := ExpandConstant('{app}\gamslice.txt');
    HandleLicenseOptions();
    UpdatePath();
    CreateShortcutVeda();
  end;
end;

function NextButtonClick(CurPage: Integer): Boolean;
var
  oldGamsVersion: String;
  oldMajor, oldMinor, oldMaintenance: Integer;
  newMajor, newMinor, newMaintenance: Integer;
  dirRes: Integer;
  dir1, dir2: String;
  dirAnsi: AnsiString;
begin
  Result:=True;
  if not WizardSilent and (wpSelectDir = CurPage) then
  begin
    Result := True;
    dir1 := ExpandConstant('{app}');
    dirAnsi := dir1;
    dir2 := dirAnsi;
    if dir1 <> dir2 then
    begin
      dirRes := MsgBox('The chosen installation directory contains non-ANSI characters that will lead to problems when using GAMS. It is highly recommended to use a location that consists of ANSI characters only.' + #13#10#13#10 +
                       'Would you like to install to that folder anyway?',
                        mbConfirmation, MB_YESNO);
      if dirRes = IDNO then
        Result := False;
    end;
    // TODO: This compares a GAMS system in the target folder against MyAppVersion,
    // which is no longer a GAMS version. Decide whether this check is still needed.
    if Result and DirExists(ExpandConstant('{app}')) then
    begin
      oldGamsVersion := GetGamsDirVersion(ExpandConstant('{app}'));
      if oldGamsVersion = '' then
        dirRes := MsgBox('The folder:'+ #13#10#13#10 + ExpandConstant('{app}') + #13#10#13#10 +
                                     'already exists. Would you like to install to that folder anyway?',
                                     mbConfirmation, MB_YESNO)
      else
      begin
        try
          newMajor       := StrToInt(Copy(ExpandConstant('{#MyAppVersion}'), 1, 2));
          newMinor       := StrToInt(Copy(ExpandConstant('{#MyAppVersion}'), 4, 1));
          newMaintenance := StrToInt(Copy(ExpandConstant('{#MyAppVersion}'), 6, 1));
          oldMajor       := StrToInt(Copy(oldGamsVersion, 1, 2));
          oldMinor       := StrToInt(Copy(oldGamsVersion, 4, 1));
          oldMaintenance := StrToInt(Copy(oldGamsVersion, 6, 1));

          if newMajor < oldMajor then
            dirRes := MsgBox('The folder:'+ #13#10#13#10 + ExpandConstant('{app}') + #13#10#13#10 +
                                         'contains a more recent GAMS installation (' + oldGamsVersion + '). Would you like to install to that folder anyway? (not recommended)',
                                         mbConfirmation, MB_YESNO)
          else if newMajor > oldMajor then
            dirRes := MsgBox('The folder:'+ #13#10#13#10 + ExpandConstant('{app}') + #13#10#13#10 +
                                         'contains an older GAMS installation (' + oldGamsVersion + '). Would you like to install to that folder anyway? (not recommended)',
                                         mbConfirmation, MB_YESNO)
          else if newMinor < oldMinor then
            dirRes := MsgBox('The folder:'+ #13#10#13#10 + ExpandConstant('{app}') + #13#10#13#10 +
                                         'contains a more recent GAMS installation (' + oldGamsVersion + '). Would you like to install to that folder anyway? (not recommended)',
                                         mbConfirmation, MB_YESNO)
          else if newMinor > oldMinor then
            dirRes := MsgBox('The folder:'+ #13#10#13#10 + ExpandConstant('{app}') + #13#10#13#10 +
                                         'contains an older GAMS installation of the same major release (' + oldGamsVersion + '). Would you like to install to that folder anyway?',
                                         mbConfirmation, MB_YESNO)
          else if newMaintenance < oldMaintenance then
            dirRes := MsgBox('The folder:'+ #13#10#13#10 + ExpandConstant('{app}') + #13#10#13#10 +
                                         'contains a more recent GAMS installation (' + oldGamsVersion + '). Would you like to install to that folder anyway? (not recommended)',
                                         mbConfirmation, MB_YESNO)
          else if newMaintenance > oldMaintenance then
            dirRes := MsgBox('The folder:'+ #13#10#13#10 + ExpandConstant('{app}') + #13#10#13#10 +
                                         'contains an older GAMS installation of the same major release (' + oldGamsVersion + '). Would you like to install to that folder anyway?',
                                         mbConfirmation, MB_YESNO)
          else
            dirRes := MsgBox('The folder:'+ #13#10#13#10 + ExpandConstant('{app}') + #13#10#13#10 +
                                         'contains a GAMS installation with an identical version number (' + oldGamsVersion + '). Would you like to install to that folder anyway?',
                                         mbConfirmation, MB_YESNO);
        except
          dirRes := MsgBox('Exception occurred while determining version information: ' + #13#10 + AddPeriod(GetExceptionMessage)+ #13#10#13#10 + 'Do you want to continue anyway?' , mbConfirmation, MB_YESNO); 
        end;
      end;
      if dirRes = IDYES then
        Result := True
      else
      begin
        WizardForm.ActiveControl := WizardForm.DirEdit;
        Result := False;
      end;
    end
  end
  else if wpGamsLicense = CurPage then
  begin
    Result := True;
    // License from Access Code is selected
    if not ALPSuccess then
    begin
      if not WizardSilent then MsgBox('Please fetch a license by clicking on the "Get License" button first.', mbConfirmation, MB_OK);
      Result := False;
    end;
  end;
end;

{called when a wizard page changes during uninstallation}
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
   Default: String;
begin
   if usUninstall = CurUninstallStep
   then
   begin
      Default := ''
      // TODO: Call RemovePath() to undo the PATH and GAMSDIR changes on uninstall
      //delete shortcuts
      DeleteFile(GetIniString('file', 'shortcut_veda', Default, ExpandConstant('{#UnInstInfo}')));
      //delete .uninstinfo.ini
      DeleteFile(ExpandConstant('{#UnInstInfo}'));
   end;
end;

{initialize the wizard}                  
procedure InitializeWizard();
begin
  LicenseStr := '';
  ALPSuccess := False;

  wpGamsLicense := CreateLicensePage;
end;
